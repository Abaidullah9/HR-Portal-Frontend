# Backend API base URL.
# Optional in development — the API client defaults to http://localhost:5000/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Playwright only. The seeded accounts the signed-in specs use; those tests skip
# when the API is unreachable. Defaults match the backend seed script.
# E2E_ADMIN_EMAIL=admin@techcorp.com
# E2E_ADMIN_PASSWORD=Password123!
# E2E_EMPLOYEE_EMAIL=employee@techcorp.com
# E2E_EMPLOYEE_PASSWORD=Password123!
# E2E_BASE_URL=http://localhost:3000
